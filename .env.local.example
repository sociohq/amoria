NEXT_PUBLIC_API_URL=http://localhost:4000

# Public Cloudflare Turnstile site key. Contact, the footer and Our Stores
# newsletter forms, the welcome popup, account registration, and the resend
# set-password link post this token as `cf-turnstile-response` (also sent as
# `turnstileToken`) plus a honeypot field `company_fax` that must stay empty.
# Leave this unset in local development: the widget is not rendered and those
# forms still submit. Set it wherever the API enforces Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
